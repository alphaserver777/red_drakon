{
    "type": "drakon",
    "items": {
        "1": { "type": "end" },
        "2": { "type": "branch", "branchId": 1, "one": "3", "content": "Граница" },
        "3": { "type": "action", "one": "4", "content": "Зафиксировать согласованные VPN, CIDR, время и запреты" },
        "4": { "type": "question", "one": "5", "two": "25", "flag1": 1, "content": "Scope и ограничения подтверждены?" },
        "5": { "type": "action", "one": "6", "content": "Не использовать учётные данные, подбор паролей и изменяющие состояние действия" },
        "6": { "type": "branch", "branchId": 2, "one": "7", "content": "Обнаружение" },
        "7": { "type": "action", "one": "8", "content": "Поднять согласованный VPN и проверить контрольный маршрут Kali" },
        "8": { "type": "action", "one": "9", "content": "Выполнить MODE=discover только в CIDR allowlist" },
        "9": { "type": "question", "one": "10", "two": "26", "flag1": 1, "content": "Есть живые хосты?" },
        "10": { "type": "action", "one": "11", "content": "Сохранить список живых хостов и coverage" },
        "11": { "type": "branch", "branchId": 3, "one": "12", "content": "Сервисы" },
        "12": { "type": "action", "one": "13", "content": "Собрать NXC-first факты и version-light Nmap по открытым портам" },
        "13": { "type": "action", "one": "14", "content": "Определить AD, веб, SMB, RDP, SSH, WinRM, SNMP, БД и NAS" },
        "14": { "type": "question", "one": "15", "two": "27", "flag1": 1, "content": "Есть сервис с безопасной безучётной проверкой?" },
        "15": { "type": "action", "one": "16", "content": "Привязать сервис к хосту, порту и технике MITRE" },
        "16": { "type": "branch", "branchId": 4, "one": "17", "content": "Проверки" },
        "17": { "type": "question", "one": "18", "two": "28", "flag1": 1, "content": "Проверка разрешена scope и не изменяет состояние?" },
        "18": { "type": "action", "one": "19", "content": "Выполнить одну безучётную проверку с лимитом времени" },
        "19": { "type": "question", "one": "20", "two": "29", "flag1": 1, "content": "Получен проверяемый факт?" },
        "20": { "type": "action", "one": "21", "content": "Сохранить вывод без секретов, время, хост, сервис и технику MITRE" },
        "21": { "type": "branch", "branchId": 5, "one": "22", "content": "Доказательства" },
        "22": { "type": "action", "one": "23", "content": "Сопоставить факт с evidence, triage и статусом связи на графе атаки" },
        "23": { "type": "action", "one": "24", "content": "Зафиксировать coverage: проверено, неприменимо, заблокировано или ошибка" },
        "24": { "type": "branch", "branchId": 6, "one": "30", "content": "Завершение" },
        "25": { "type": "action", "one": "24", "content": "БЛОКИРОВКА: запросить точный scope; не подключаться и не сканировать" },
        "26": { "type": "action", "one": "24", "content": "status=empty: сохранить coverage и завершить цель" },
        "27": { "type": "action", "one": "24", "content": "Неприменимо: сохранить сервисный охват без дальнейшей проверки" },
        "28": { "type": "action", "one": "24", "content": "Заблокировано: указать запрет и безопасную альтернативу" },
        "29": { "type": "action", "one": "24", "content": "Нет факта: сохранить ошибку или отсутствие результата; не считать успехом" },
        "30": { "type": "action", "one": "31", "content": "Передать run lifecycle, coverage, evidence, manifest и triage в панель" },
        "31": { "type": "action", "one": "1", "content": "Отключить VPN, проверить ppp0 и контрольный маршрут, передать отчёт" }
    },
    "keywords": {
