{
    "type": "drakon",
    "items": {
        "1": { "type": "end" },
        "2": { "type": "branch", "branchId": 0, "one": "3", "content": "Доказательства" },
        "3": { "type": "action", "one": "4", "content": "Для каждого факта сохранить источник, хост, сервис, время и безопасное описание" },
        "4": { "type": "question", "one": "5", "two": "10", "flag1": 1, "content": "Есть исходный артефакт: Nmap XML, NXC text, факт или вывод команды?" },
        "5": { "type": "action", "one": "6", "content": "Сопоставить факт с хостом, портом, находкой и техникой MITRE" },
        "6": { "type": "question", "one": "7", "two": "11", "flag1": 1, "content": "Секреты исключены из артефакта и журналов?" },
        "7": { "type": "action", "one": "8", "content": "Выполнить triage и пометить подтверждённое, планируемое либо неудавшееся" },
        "8": { "type": "action", "one": "9", "content": "Передать run lifecycle, coverage, evidence, manifest и triage в панель" },
        "9": { "type": "question", "one": "12", "two": "13", "flag1": 1, "content": "Загрузка подтверждена панелью?" },
        "10": { "type": "action", "one": "1", "content": "Не создавать вывод. Статус: недостаточно доказательств" },
        "11": { "type": "action", "one": "1", "content": "Удалить секрет из записи, не удаляя первичный факт; зафиксировать безопасную ссылку" },
        "12": { "type": "action", "one": "1", "content": "Переход к 07-zavershenie.drakon" },
        "13": { "type": "action", "one": "1", "content": "Зафиксировать ошибку загрузки и не объявлять прогон завершённым" }
    },
    "keywords": { "function": false, "machine": false, "async": false, "export": false, "algoprop": false, "lazy": false },
    "params": "Этап 06. Доказательства"
