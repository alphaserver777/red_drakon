{
  "type": "drakon",
  "name": "09-no-creds-full-siluet",
  "params": "Проект полного этапа без учётных данных. Только согласованный внутренний аудит: инвентаризация, безопасные проверки и доказательства. До появления утверждённого исполнителя схема не запускается на сети.",
  "items": {
    "1": { "type": "end" },
    "2": { "type": "branch", "branchId": 1, "one": "3", "content": "Граница и режим" },
    "3": { "type": "action", "one": "4", "content": "Зафиксировать задачу, утверждённый SHA, VPN-цель, CIDR, исключения, лимиты и время. Начать хешированный журнал." },
    "4": { "type": "question", "one": "5", "two": "40", "flag1": 1, "content": "Граница, SHA и разрешение оператора подтверждены?" },
    "5": { "type": "action", "one": "6", "content": "Режим «нет учётных данных»: запретить вход, guest, null-session, подбор, эксплуатацию, изменение состояния, сбор секретов и перехват трафика." },
    "6": { "type": "action", "one": "7", "content": "Поднять согласованный VPN. Зафиксировать ppp0 и проверить, что управляющий маршрут Kali не идёт через VPN. [MITRE T1016]" },
    "7": { "type": "question", "one": "8", "two": "41", "flag1": 1, "content": "VPN, ppp0 и маршруты разрешённых CIDR корректны?" },

    "8": { "type": "branch", "branchId": 2, "one": "9", "content": "Живые хосты" },
    "9": { "type": "action", "one": "10", "content": "Контрольная точка: показать CIDR, лимит скорости и метод поиска живых хостов. Ждать отдельного разрешения на активное сканирование. [MITRE T1595.001]" },
    "10": { "type": "question", "one": "11", "two": "42", "flag1": 1, "content": "Оператор разрешил поиск живых хостов этой версии?" },
    "11": { "type": "action", "one": "12", "content": "Найти живые хосты только в разрешённых CIDR, с лимитом скорости и времени. Сохранить coverage и исходный вывод. [MITRE T1018]" },
    "12": { "type": "question", "one": "13", "two": "43", "flag1": 1, "content": "Найдены живые хосты?" },
    "13": { "type": "action", "one": "14", "content": "Передать список живых хостов и coverage в панель. Не переходить к сервисам без нового разрешения." },

    "14": { "type": "branch", "branchId": 3, "one": "15", "content": "Поверхность сервисов" },
    "15": { "type": "action", "one": "16", "content": "Контрольная точка: показать живые хосты, выбранный безопасный профиль портов, лимит и время. Ждать разрешения на инвентаризацию сервисов. [MITRE T1046]" },
    "16": { "type": "question", "one": "17", "two": "44", "flag1": 1, "content": "Оператор разрешил инвентаризацию сервисов этой версии?" },
    "17": { "type": "action", "one": "18", "content": "Собрать только согласованный профиль портов и лёгкие баннеры по открытым портам. Не выполнять полный перебор портов, учётный вход или проверку уязвимостей." },
    "18": { "type": "action", "one": "19", "content": "Классифицировать поверхность: веб, SMB, RDP, SSH, WinRM, LDAP, SNMP, БД, NAS и устройства. Связать сервис с хостом, портом и доказательством. [MITRE T1046]" },
    "19": { "type": "question", "one": "20", "two": "32", "flag1": 1, "content": "Есть сервис с заранее описанной безопасной безучётной проверкой?" },

    "20": { "type": "branch", "branchId": 4, "one": "21", "content": "Безучётная проверка" },
    "21": { "type": "action", "one": "22", "content": "Для каждого кандидата выбрать ровно одну проверку из утверждённого справочника: HTTP/TLS-метаданные, LDAP RootDSE, SMB без входа либо только версия и конфигурация. Указать технику MITRE и ожидаемый факт." },
    "22": { "type": "question", "one": "23", "two": "45", "flag1": 1, "content": "Проверка не использует секрет, не меняет состояние, не извлекает данные и явно разрешена границей?" },
    "23": { "type": "action", "one": "24", "content": "Выполнить утверждённую проверку с лимитом времени и одной целью. Не повторять при ошибке автоматически." },
    "24": { "type": "question", "one": "25", "two": "46", "flag1": 1, "content": "Получен проверяемый факт о доступности, версии или небезопасной конфигурации?" },
    "25": { "type": "action", "one": "26", "content": "Сохранить минимальное доказательство без секретов: время, хост, порт, техника MITRE, результат и ссылка на исходный вывод." },
    "26": { "type": "question", "one": "27", "two": "28", "flag1": 1, "content": "Остались разрешённые кандидаты для такой же безопасной проверки?" },
    "27": { "type": "action", "one": "21", "content": "Выбрать следующий кандидат. Не расширять профиль проверок и не повышать интенсивность." },

    "28": { "type": "branch", "branchId": 5, "one": "29", "content": "Доказательства и охват" },
    "29": { "type": "action", "one": "30", "content": "Для каждого CIDR, хоста, сервиса и проверки записать coverage: проверено, неприменимо, заблокировано, нет факта или ошибка." },
    "30": { "type": "action", "one": "31", "content": "Передать через API факты о хостах и сервисах, coverage, доказательства, manifest и хешированный журнал. Не передавать секреты и содержимое чувствительных данных." },
    "31": { "type": "question", "one": "33", "two": "47", "flag1": 1, "content": "У каждого результата есть coverage и доказательство либо безопасная причина отсутствия?" },

    "32": { "type": "action", "one": "28", "content": "Нет применимой проверки: сохранить сервисный охват как «неприменимо» и не выполнять сетевых действий сверх инвентаризации." },
    "33": { "type": "branch", "branchId": 6, "one": "34", "content": "Завершение" },
    "34": { "type": "action", "one": "35", "content": "Сформировать итог: найденные факты, риски, блокировки, покрытие и следующий безопасный этап. Не заявлять эксплуатацию или доступ без доказательства." },
    "35": { "type": "action", "one": "36", "content": "Отключить VPN, подтвердить отсутствие ppp0 и сохранность управляющего маршрута." },
    "36": { "type": "action", "one": "1", "content": "Передать финальный журнал. Статус live возможен только при полном coverage и завершении этого силуэта; empty — при отсутствии живых хостов." },

    "40": { "type": "action", "one": "33", "content": "Заблокировано: запросить точную границу, задачу и утверждённый SHA. Не подключать VPN и не сканировать." },
    "41": { "type": "action", "one": "33", "content": "Статус dead или blocked: сохранить доказательство ошибки VPN или маршрута. Отключить VPN, если он был поднят." },
    "42": { "type": "action", "one": "33", "content": "Заблокировано: поиск живых хостов не разрешён. Сохранить контрольную точку и отключить VPN." },
    "43": { "type": "action", "one": "33", "content": "Статус empty: сохранить coverage поиска живых хостов, доказательство и причину отсутствия результатов." },
    "44": { "type": "action", "one": "28", "content": "Инвентаризация сервисов не разрешена: сохранить уже полученный охват хостов и безопасную причину остановки." },
    "45": { "type": "action", "one": "28", "content": "Заблокировано: проверка выходит за границу или риск. Сохранить причину и безопасную альтернативу без её запуска." },
    "46": { "type": "action", "one": "26", "content": "Нет подтверждённого факта: сохранить отсутствие результата или ошибку. Не считать это успехом и не повторять автоматически." },
    "47": { "type": "action", "one": "33", "content": "Охват неполный: зафиксировать конкретные непокрытые объекты и причину. Не объявлять этап успешно завершённым." }
  }
}
