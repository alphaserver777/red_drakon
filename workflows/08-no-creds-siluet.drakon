{
  "type": "drakon",
  "name": "08-no-creds-siluet",
  "params": "Исполнимый эксперимент без учётных данных, сервисов и портов",
  "agentPolicy": { "credentials": "forbidden", "services": "forbidden", "ports": "forbidden", "mitreChecks": "forbidden", "scope": "all-ppp0-routes", "supernetGuard": "block-larger-than-/16" },
  "items": {
    "1": { "type": "end" },
    "2": { "type": "branch", "branchId": 1, "one": "3", "content": "Эксперимент 08" },
    "3": { "type": "action", "one": "4", "content": "Зафиксировать задачу, SHA схемы и согласованную границу ppp0", "agent": {"op":"preflight","executor":"runner","inputs":["taskId","schemaRef"],"evidence":["gitSha","runManifest"],"next":"4"} },
    "4": { "type": "question", "one": "5", "two": "16", "flag1": 1, "content": "Есть task ID и утверждённый Git SHA?", "agent": {"op":"check-task-sha","executor":"runner","next":"5|16"} },
    "5": { "type": "action", "one": "6", "content": "Поднять VPN через утверждённый исполнитель и штатный vpn-connect", "agent": {"op":"vpn-up","executor":"runner","evidence":["vpnResult"],"next":"6"} },
    "6": { "type": "question", "one": "7", "two": "17", "flag1": 1, "content": "VPN подключён и ppp0 существует?", "agent": {"op":"check-ppp0","executor":"runner","next":"7|17"} },
    "7": { "type": "action", "one": "8", "content": "Сохранить маршруты ppp0 и проверить управляющий маршрут Kali", "agent": {"op":"route-check","executor":"runner","inputs":["ppp0"],"evidence":["ppp0Routes","controlRoute"],"next":"8"} },
    "8": { "type": "question", "one": "9", "two": "18", "flag1": 1, "content": "Граница ppp0 корректна, а supernet не требует остановки?", "agent": {"op":"check-route","executor":"runner","next":"9|18"} },
    "9": { "type": "action", "one": "10", "content": "КОНТРОЛЬНАЯ ТОЧКА: ждать разрешения оператора перед discovery", "agent": {"op":"checkpoint","executor":"operator","next":"10"} },
    "10": { "type": "question", "one": "11", "two": "19", "flag1": 1, "content": "Оператор разрешил discovery этой версии?", "agent": {"op":"check-approval","executor":"runner","next":"11|19"} },
    "11": { "type": "action", "one": "12", "content": "Найти живые хосты только в маршрутах ppp0", "agent": {"op":"discover-live","executor":"runner","evidence":["liveHosts","coverage"],"next":"12"} },
    "12": { "type": "question", "one": "13", "two": "14", "flag1": 1, "content": "Найдены живые хосты?", "agent": {"op":"check-live","executor":"runner","next":"13|14"} },
    "13": { "type": "action", "one": "15", "content": "status=live: сохранить hosts, coverage и доказательство", "agent": {"op":"result-live","executor":"runner","next":"15"} },
    "14": { "type": "action", "one": "15", "content": "status=empty: сохранить coverage и отсутствие живых хостов", "agent": {"op":"result-empty","executor":"runner","next":"15"} },
    "15": { "type": "action", "one": "1", "content": "Завершить эксперимент, отключить VPN и передать хешированный журнал", "agent": {"op":"finish","executor":"runner","next":"1"} },
    "16": { "type": "action", "one": "1", "content": "status=blocked: отсутствует task ID или утверждённый SHA; сетевые действия запрещены", "agent": {"op":"result-blocked","executor":"runner","next":"1"} },
    "17": { "type": "action", "one": "1", "content": "status=dead: VPN/ppp0 недоступен; сохранить доказательство", "agent": {"op":"result-dead","executor":"runner","next":"1"} },
    "18": { "type": "action", "one": "1", "content": "status=blocked: маршрут некорректен или требует отдельного разрешения", "agent": {"op":"result-blocked","executor":"runner","next":"1"} },
    "19": { "type": "action", "one": "15", "content": "status=blocked: discovery не разрешён; отключить VPN и передать журнал", "agent": {"op":"result-blocked","executor":"runner","next":"15"} }
  },
  "keywords": { "function": false, "machine": false, "async": false, "export": false, "algoprop": false, "lazy": false }
}
