{
  "type": "drakon",
  "name": "08-no-creds-siluet",
  "params": "Исполнимый эксперимент: только VPN и поиск живых хостов. Учётные данные, сервисы и порты запрещены.",
  "items": {
    "1": { "type": "end" },
    "2": { "type": "branch", "branchId": 1, "one": "3", "content": "Эксперимент 08" },
    "3": { "type": "action", "one": "4", "content": "Зафиксировать номер задачи, Git SHA схемы и границу ppp0. Записать начало в хешированный журнал." },
    "4": { "type": "question", "one": "5", "two": "16", "flag1": 1, "content": "Есть номер задачи и утверждённый Git SHA? При «нет» не выполнять сетевых действий." },
    "5": { "type": "action", "one": "6", "content": "Поднять VPN для занятой задачи штатным vpn-connect. Не передавать секреты через аргументы процесса." },
    "6": { "type": "question", "one": "7", "two": "17", "flag1": 1, "content": "VPN подключён и интерфейс ppp0 существует? При «нет» сохранить ошибку VPN." },
    "7": { "type": "action", "one": "8", "content": "Сохранить CIDR-маршруты ppp0 и проверить, что управляющий маршрут Kali не идёт через ppp0." },
    "8": { "type": "question", "one": "9", "two": "18", "flag1": 1, "content": "Маршруты ppp0 корректны и не крупнее /16? При «нет» остановиться без discovery." },
    "9": { "type": "action", "one": "10", "content": "Контрольная точка: сохранить маршруты и ждать отдельного разрешения оператора перед discovery." },
    "10": { "type": "question", "one": "11", "two": "19", "flag1": 1, "content": "Оператор разрешил discovery этой версии? При «нет» завершить эксперимент без сканирования." },
    "11": { "type": "action", "one": "12", "content": "Найти живые хосты только в маршрутах ppp0 командой nmap -sn. Не выполнять иные сетевые проверки." },
    "12": { "type": "question", "one": "13", "two": "14", "flag1": 1, "content": "Найдены живые хосты?" },
    "13": { "type": "action", "one": "15", "content": "Сохранить список живых хостов, coverage и файл доказательства. Передать результаты в панель." },
    "14": { "type": "action", "one": "15", "content": "Сохранить coverage и статус empty: живые хосты не найдены." },
    "15": { "type": "action", "one": "1", "content": "Завершить эксперимент, отключить VPN и передать хешированный журнал." },
    "16": { "type": "action", "one": "1", "content": "Завершить со статусом blocked: нет задачи или утверждённого SHA; сетевые действия не выполнялись." },
    "17": { "type": "action", "one": "1", "content": "Завершить со статусом dead: VPN или ppp0 недоступен; сохранить доказательство." },
    "18": { "type": "action", "one": "1", "content": "Завершить со статусом blocked: маршрут некорректен или требует отдельного разрешения." },
    "19": { "type": "action", "one": "15", "content": "Завершить со статусом blocked: discovery не разрешён; отключить VPN и передать журнал." }
  },
  "keywords": { "function": false, "machine": false, "async": false, "export": false, "algoprop": false, "lazy": false }
}
