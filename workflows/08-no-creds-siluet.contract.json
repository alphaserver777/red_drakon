{
  "workflow": "08-no-creds-siluet",
  "diagram": "workflows/08-no-creds-siluet.drakon",
  "version": 1,
  "policy": {
    "credentials": "forbidden",
    "services": "forbidden",
    "ports": "forbidden",
    "mitreChecks": "forbidden",
    "scope": "all-ppp0-routes",
    "supernetGuard": "block-larger-than-/16"
  },
  "operations": {
    "3": { "kind": "preflight", "executor": "runner", "inputs": ["taskId", "schemaRef"], "evidence": ["gitSha", "runManifest"], "next": "4" },
    "4": { "kind": "decision", "executor": "runner", "success": "5", "failure": "16" },
    "5": { "kind": "vpn-up", "executor": "runner", "command": "panel vpn-target → vpn-connect.sh up", "evidence": ["vpnResult"], "next": "6" },
    "6": { "kind": "decision", "executor": "runner", "success": "7", "failure": "17" },
    "7": { "kind": "route-check", "executor": "runner", "inputs": ["ppp0"], "evidence": ["ppp0Routes", "controlRoute"], "next": "8" },
    "8": { "kind": "decision", "executor": "runner", "success": "9", "failure": "18" },
    "9": { "kind": "checkpoint", "executor": "operator", "checkpoint": "before-discovery", "next": "10" },
    "10": { "kind": "decision", "executor": "runner", "success": "11", "failure": "19" },
    "11": { "kind": "discover", "executor": "runner", "command": "nmap -sn -n <ppp0-route>", "evidence": ["liveHosts", "coverage"], "next": "12" },
    "12": { "kind": "decision", "executor": "runner", "success": "13", "failure": "14" },
    "13": { "kind": "result", "executor": "runner", "status": "live", "next": "15" },
    "14": { "kind": "result", "executor": "runner", "status": "empty", "next": "15" },
    "15": { "kind": "finish", "executor": "runner", "next": "1" },
    "16": { "kind": "result", "executor": "runner", "status": "blocked", "next": "1" },
    "17": { "kind": "result", "executor": "runner", "status": "dead", "next": "1" },
    "18": { "kind": "result", "executor": "runner", "status": "blocked", "next": "1" },
    "19": { "kind": "result", "executor": "runner", "status": "blocked", "next": "15" }
  }
}
